# Server Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development
GIN_MODE=release

# PostgreSQL (local docker-compose maps port 5433 on host to 5432 in container)
POSTGRES_URI=postgres://postgres:postgres@127.0.0.1:5433/xploitverse?sslmode=disable

# Redis (from docker-compose)
REDIS_URL=redis://127.0.0.1:6379

# JWT Configuration (generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# CORS
CLIENT_URL=http://localhost:5173

# Payment (Razorpay Test Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS Configuration (Phase 2+)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# SMTP Email Configuration
# For Gmail: Host=smtp.gmail.com, Port=587, use App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=XploitVerse
