# Server Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development
GIN_MODE=release

# PostgreSQL (local docker-compose maps port 5433 on host to 5432 in container)
POSTGRES_URI=postgres://postgres:postgres@127.0.0.1:5433/xploitverse?sslmode=disable

# Redis (from docker-compose)
REDIS_URL=redis://127.0.0.1:6379

# JWT Configuration (generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# CORS
CLIENT_URL=http://localhost:5173

# Payment (Razorpay Test Keys) — per-lab usage billing via one-time orders.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: enables HMAC verification of Razorpay webhooks (dashboard → webhooks).
RAZORPAY_WEBHOOK_SECRET=

# Lab usage billing (see docs/PRICING.md for the AWS cost derivation)
# Free tier length before an extension is required.
LAB_FREE_MINUTES=59
# Pay-as-you-go rate per lab hour, in INR.
LAB_HOURLY_RATE_INR=9
# Hard cap on the lifetime of a single session (minutes), including paid time.
LAB_MAX_SESSION_MINUTES=480
# How many minutes before expiry the workspace warns the user.
LAB_WARN_MINUTES=10

# AWS Configuration (Phase 2+)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# SMTP Email Configuration
# For Gmail: Host=smtp.gmail.com, Port=587, use App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=XploitVerse
