#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker git nginx
systemctl enable --now docker
systemctl enable --now nginx

usermod -aG docker ec2-user

mkdir -p /opt/xploitverse/backend
mkdir -p /opt/xploitverse/client

cat >/opt/xploitverse/backend/.env <<EOF
PORT=5000
NODE_ENV=production
POSTGRES_URI=${postgres_uri}?sslmode=require
REDIS_URL=${redis_url}
JWT_SECRET=${jwt_secret}
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
CLIENT_URL=${client_url}
AWS_REGION=${aws_region}
EOF

if [ -n "${app_repo_url}" ]; then
  if [ ! -d /opt/xploitverse/repo/.git ]; then
    git clone --branch "${app_branch}" "${app_repo_url}" /opt/xploitverse/repo
  else
    cd /opt/xploitverse/repo
    git fetch origin
    git checkout "${app_branch}"
    git pull --ff-only origin "${app_branch}"
  fi
fi

cat >/etc/nginx/conf.d/xploitverse.conf <<'EOF'
server {
  listen 80 default_server;
  server_name _;

  location / {
    proxy_pass http://127.0.0.1:5173;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/ {
    proxy_pass http://127.0.0.1:5000/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /ws/ {
    proxy_pass http://127.0.0.1:5000/ws/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
EOF

nginx -t
systemctl reload nginx
